<?xml version="1.0"?>
<sdf version="1.5">
  <world name="hexa_phynt">
    <physics name="1ms" type="unused">
      <max_step_size>0.002000</max_step_size>
      <real_time_factor>1.000000</real_time_factor>
      <real_time_update_rate>500.000000</real_time_update_rate>
      <gravity>0 0 -9.81</gravity>
      <magnetic_field>23.816e-6 -0.41e-6 -39.829e-6</magnetic_field>
    </physics>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1.0</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1.0</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.2 0.8 0.2 1</diffuse>
            <specular>0.2 0.8 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://fah_arm</uri>
      <name>fahexa</name>
      <pose>0 0 0.4 0 0 0</pose>
    </include>

    <!--
    <include>
      <uri>model://ground_arm</uri>
      <name>ground_arm</name>
      <pose>1.5 0 0 0 0 3.14159</pose>
    </include>
    -->

    <!-- ============================================================
         Tavolo + cubo per la demo pick-and-place.
         Il braccio (ground_arm) è a world (1.5, 0, 0) con yaw=pi,
         quindi il suo frame locale è specchiato in X.
         - Cubo al local (0.42, 0, 0.225)  →  world (1.08, 0, 0.225)
         - EE di presa al local (0.38, 0, 0.225): le dita (offset +0.04 m in X
           locale) arrivano esattamente a x=0.42 dove si trova il cubo.
         Il tavolo è statico e serve solo da supporto.
    ============================================================ -->
    <model name="table">
      <static>true</static>
      <pose>1.08 0 0.10 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>0.20 0.20 0.20</size></box></geometry>
          <material>
            <ambient>0.5 0.3 0.1 1</ambient>
            <diffuse>0.5 0.3 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="col">
          <geometry><box><size>0.20 0.20 0.20</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="cube">
      <pose>1.08 0 0.225 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <!-- cubo solido 5 cm: I = m*a²/6 -->
          <inertia><ixx>2.08e-5</ixx><ixy>0</ixy><ixz>0</ixz>
                   <iyy>2.08e-5</iyy><iyz>0</iyz><izz>2.08e-5</izz></inertia>
        </inertial>
        <visual name="vis">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material>
            <ambient>1.0 0.5 0.0 1</ambient>
            <diffuse>1.0 0.5 0.0 1</diffuse>
          </material>
        </visual>
        <collision name="col">
          <surface>
            <friction><ode><mu>4.0</mu><mu2>4.0</mu2></ode></friction>
          </surface>
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Secondo piedistallo per il deposito del cubo -->
    <model name="pedestal_2">
      <static>true</static>
      <pose>-1.0 0 0.10 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>0.20 0.20 0.20</size></box></geometry>
          <material>
            <ambient>0.1 0.2 0.7 1</ambient>
            <diffuse>0.1 0.2 0.7 1</diffuse>
          </material>
        </visual>
        <collision name="col">
          <geometry><box><size>0.20 0.20 0.20</size></box></geometry>
        </collision>
      </link>
    </model>

    <plugin name="optitrack" filename="optitrack-gazebo.so">
      <hz>100</hz>
      <port>1509</port>
      <publish>
        <link>fahexa::base</link>
        <name>FH</name>
      </publish>
    </plugin>

  </world>
</sdf>
